{
  "name": "forgesight-workbench",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "format": "prettier --write src e2e *.ts *.json index.html",
    "format:check": "prettier --check src e2e *.ts *.json index.html",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.3.0",
    "@tanstack/react-query": "5.104.1",
    "lucide-react": "1.55.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.0",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "prettier": "3.9.10",
    "typescript": "7.0.2",
    "vite": "8.3.4"
  }
}
